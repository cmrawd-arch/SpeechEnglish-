# ============================================================
# SPEECH ENGLISH — MODÈLE DE CONFIGURATION (.env.example)
# Copiez ce fichier en ".env" et adaptez les valeurs locales.
# ============================================================

# Configuration générale de l'application
APP_NAME="Speech English"
APP_ENV=development
APP_URL=http://localhost/SpeechEnglish/public

# Configuration de la base de données MySQL / MariaDB (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=speech_english
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
